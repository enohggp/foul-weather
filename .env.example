# All optional. The game runs with none of these set.

# Web build
VITE_FW_CONTRACT=foulweather-harbor.testnet
# Your own NEAR Auth client id, needed for Google and email login on a hosted site.
VITE_FW_AUTH_CLIENT_ID=

# Scripts
FW_CONTRACT=foulweather-harbor.testnet
# A key for the deployer or reporter account. Without it, scripts read ~/.near-credentials.
NEAR_PRIVATE_KEY=
# Lets scripts/agent-house.mjs ask a model on NEAR AI Cloud.
NEAR_AI_API_KEY=
